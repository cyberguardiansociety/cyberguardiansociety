# Cyber Guardian Society Environment Variables
#
# Copy to `.env.local` or `.env` and fill in real values. Never commit filled-in secrets.

NEXT_PUBLIC_APP_NAME="Cyber Guardian Society"
NEXT_PUBLIC_APP_TAGLINE="Secure Today. Stronger Tomorrow."
NEXT_PUBLIC_API_BASE_URL="/api"

# Public canonical URL used for metadata. Set the production domain before build.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Server-only canonical origin for production CSRF checks and assistant crawling.
SITE_URL="http://localhost:3000"

# Allowed browser origins for the optional Express backend.
CORS_ORIGINS="http://localhost:3000"

# ── Admin credentials (used by scripts/seed-admin.ts to seed the first admin) ──
# The password is hashed with Argon2id before it is stored in SQLite.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password

# ── Administrative Security & Hardening ─────────────────────────────────────
# Secret admin URL base slug. Must start with '/' and be at least 20 random characters.
# Generate with: node scripts/generate-admin-path.js
ADMIN_BASE_PATH=/replace-with-a-long-random-admin-path

# Session & Token Signing Key (Min 32 characters / 256 bits).
SESSION_SECRET=replace-with-a-unique-32-byte-secret

# Key that encrypts stored TOTP secrets (maintenance module only).
TOTP_ENCRYPTION_KEY=replace-with-a-unique-32-byte-encryption-key

# Optional: IP allowlist for admin access (comma-separated list of IPv4 / IPv6 addresses).
# If unset, access is controlled by password authentication, lockout, and rate-limiting.
# ADMIN_IP_ALLOWLIST="203.0.113.195,198.51.100.42"

# ── Attendance portal / Google Sheets sync ───────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@example.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=replace-with-service-account-private-key

# ── CGS website assistant ──────────────────────────────────────────────────
GROQ_API_KEY=replace-with-your-groq-api-key

# ── Node & Deployment ───────────────────────────────────────────────────────
# PORT is consumed by Next.js; BACKEND_PORT by the Express backend.
# They must never be the same value.
PORT="3000"
BACKEND_PORT="5001"
