{
  "name": "cyber-guardian-society-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "next dev",
    "dev:backend": "tsx watch backend/server.ts",
    "build": "next build",
    "build:backend": "tsc --project backend/tsconfig.json",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit --project backend/tsconfig.json",
    "lint": "npm run typecheck",
    "test:adapter": "tsx scripts/test-adapter.ts",
    "test:admin": "node scripts/test-admin-actions.mjs",
    "test:applications": "node scripts/test-applications.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "clean:test-data": "node scripts/clean-test-data.mjs",
    "verify": "npm run typecheck && npm run test:adapter",
    "test": "npm run verify",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "admin:provision-master": "tsx scripts/provision-master-admin.ts",
    "admin:password": "tsx scripts/set-admin-password.ts"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "googleapis": "^185.0.0",
    "hash-wasm": "^4.12.0",
    "helmet": "^8.3.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.56.0",
    "motion": "^14.2.0",
    "next": "16.4.3",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hot-toast": "^2.6.1",
    "server-only": "^0.0.1",
    "sql.js": "^1.14.2",
    "tw-animate-css": "^1.4.0",
    "winston": "^3.19.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
